[Unit]
Description=Telegram agent for Garmin endurance data
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/garmin-endurance/env
ExecStart=%h/.local/share/garmin-endurance/venv/bin/python %h/.local/share/garmin-endurance/telegram_adapter.py

# long polling 會一直斷線重連，斷了就該自己爬起來。
# 設定錯誤（缺 token、缺白名單）會 exit 2，那種情況重啟也沒用，
# 但 systemd 分不出來，所以靠 StartLimit 避免無窮快速重啟洗爆 journal。
Restart=always
RestartSec=15
StartLimitIntervalSec=300
StartLimitBurst=10

Nice=10

# 跟 fetch 那支一樣的隔離範圍：要寫 DB、要讀 Garmin token
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/garmin-endurance %h/.garminconnect %h/.cache

[Install]
WantedBy=default.target
